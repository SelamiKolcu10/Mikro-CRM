MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/microcrm
JWT_SECRET=replace_with_random_base64_secret
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# npm run dev:all
# JWT_SECRET must be IDENTICAL across backend, invoice-ocr-service, and invoice-ocr-v2 .env files
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
