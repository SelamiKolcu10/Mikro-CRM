MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/microcrm
# selamikolcu52_db_user
# lFsXkbzsl0Ojohfq
# Rastgele üret, ASLA elle yazma:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=generate_me_see_comment_above

PORT=5000

# NODE_ENV=production iken iki şey değişir:
#   1. FRONTEND_URL https:// ile başlamak ZORUNDA — değilse sunucu açılmaz.
#      (Bu değer aynı zamanda CORS origin'idir; http olması JWT'yi ağda açık
#      taşıyan bir kurulumu onaylamak demektir.)
#   2. TRUST_PROXY de tanımlıysa http istekleri 308 ile https'e yönlendirilir.
#   3. Beklenmeyen (500) hataların ham mesajı istemciye dönmez.
NODE_ENV=development

FRONTEND_URL=http://localhost:5173

# Ters vekil (nginx / Cloudflare / Render / Railway) arkasındaysanız AYARLAYIN:
# değer = önünüzdeki güvenilen vekil sayısı (tek vekil için 1). Boş bırakılırsa
# Express X-Forwarded-For'a hiç bakmaz.
#
# Vekil YOKSA boş bırakın — açık olması istemcinin kendi X-Forwarded-For
# başlığını uydurup rate limit'i tamamen atlatmasına izin verir.
# TRUST_PROXY=1

# npm run dev:all
# JWT_SECRET must be IDENTICAL across backend, invoice-ocr-service, and invoice-ocr-v2 .env files
