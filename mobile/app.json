{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selamikolcu.microcrm"
    },
    "android": {
      "package": "com.selamikolcu.microcrm",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fatura fotoğrafı çekebilmek için kamera erişimi gerekiyor.",
          "photosPermission": "Galerinizden fatura görseli seçebilmek için erişim gerekiyor."
        }
      ],
      "expo-sharing"
    ]
  }
}
